# WiFi credentials baked into the image at build time.
#
# Copy this file to `wifi.env` (same directory) and fill in your network. If
# `os-image/wifi.env` exists when you run ./build.sh, stage 07-wifi writes a
# NetworkManager connection into the image so the Pi joins WiFi on first boot.
# If it's absent, WiFi is simply not preconfigured (Ethernet still works).
#
# `wifi.env` is gitignored — it holds your password, so it's never committed.
#
#   cp wifi.env.example wifi.env && $EDITOR wifi.env

WIFI_SSID="Your Network Name"
WIFI_PSK="your-wifi-password"

# 2-letter ISO country for the WLAN regulatory domain. Optional — if unset, the
# image's default (WPA_COUNTRY in os-image/config, 'US') applies. WiFi won't
# associate (especially on 5 GHz) unless the country is correct.
# WIFI_COUNTRY="US"

# Set to 1 only if your network is hidden (does not broadcast its SSID).
# WIFI_HIDDEN=0
