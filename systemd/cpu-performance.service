[Unit]
Description=CPU governor + IRQ affinity for the isolated-core audio layout
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 1) CPU governor -> performance, immediately.
ExecStart=/bin/bash -c 'echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null'
# 2) IRQs -> core 0, off the isolated audio cores. In its own script because it
#    has to run several times: an IRQ that no driver has registered yet cannot
#    be steered, and a single pass at boot left 44 of this board's IRQs on the
#    default all-CPU mask. See scripts/set-irq-affinity.sh for the measurements.
#
#    This takes ~20s and nothing is ordered after this unit, so it delays
#    nothing. Not backgrounded: systemd would kill it with the control group
#    when the main process exited.
ExecStart=/home/synth/synth/scripts/set-irq-affinity.sh

[Install]
WantedBy=multi-user.target
