[Unit]
Description=ALSA-to-JACK MIDI bridge (a2jmidid)
# Bridges ALSA-seq hardware MIDI (USB keyboards) into JACK MIDI, which is what
# every engine consumes (mod-host, and a Pianoteq process if ever added).
# Bridged keyboards appear under the "a2j:" JACK client; the UI (EngineManager)
# wires them to the active engine's MIDI input on each voice switch.
After=jack.service
Requires=jack.service
PartOf=jack.service

[Service]
Type=simple
User=synth
# -e / --export-hw is opt-IN for hardware ports, not a restriction to them:
# without it a2jmidid *skips* hardware ports (port_thread.c: "Ignoring hardware
# port"), which is the opposite of what we want — USB keyboards are exactly the
# ports we need. It does not suppress software ALSA-seq clients; "Midi Through"
# and friends still get exported alongside. That's fine: they aren't marked
# JackPortIsPhysical, and JackGraph.keyboard_midi_sources() selects on the
# physical flag, so only real jacks are ever wired to an engine.
# Pinned to core 1 with JACK (it's light — sparse MIDI events, not DSP).
ExecStart=/usr/bin/taskset -c 1 /usr/bin/a2jmidid -e
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
