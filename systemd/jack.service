[Unit]
Description=JACK Audio Server
After=sound.target

[Service]
Type=simple
User=synth
Environment=JACK_NO_AUDIO_RESERVATION=1
# The wrapper picks the ALSA card (saved -> HiFiBerry -> first -> dummy backend)
# and execs jackd with chrt -f 90 / taskset -c 1, so core 1 (the audio heartbeat)
# runs alone. Device is selectable at runtime; see scripts/start-jack.sh.
ExecStart=/home/synth/synth/scripts/start-jack.sh
LimitRTPRIO=90
LimitMEMLOCK=infinity
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
